# Central Yards workspace, environment variables
# Copy to .env.local for local work. In production set these in the Vercel dashboard.
# Never commit real values.

# Cookie signing value. Any long random string. Changing it signs everyone out.
GATE_SECRET=

# How many days an access code stays valid.
GATE_DAYS=30

# Access codes, comma separated, one per team.
# Format: scope:salt:sha256(salt + normalised code)
# scope is either adam or cy.
# Generate with:
#   python3 -c "import hashlib;n=''.join(c for c in 'YOURCODE'.lower() if c.isalnum());print('adam:cyadam7f3a:'+hashlib.sha256(('cyadam7f3a'+n).encode()).hexdigest())"
GATE_CODES=

# Supabase, add only when the database is connected.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
